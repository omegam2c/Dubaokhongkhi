import pandas as pd
import requests
import time

# 1. Cấu hình danh sách các quận (Tên, Tọa độ, và Đặc trưng tĩnh)
districts = [
    {"name": "Dong_Da", "lat": 21.012, "lon": 105.828, "area_type": 3, "pop_density": 37000},
    {"name": "Cau_Giay", "lat": 21.036, "lon": 105.795, "area_type": 2, "pop_density": 23000},
    {"name": "Soc_Son", "lat": 21.258, "lon": 105.816, "area_type": 1, "pop_density": 1100}
]

# 2. Cấu hình khoảng thời gian muốn lấy (Định dạng: YYYY-MM-DD)
# Khuyên dùng: Lấy từ năm 2024 đến giữa năm 2026 để dữ liệu đủ dày cho mô hình học
start_date = "2024-01-01"
end_date = "2026-05-31"

all_district_data = []

print("--- Bắt đầu tải dữ liệu từ Open-Meteo ---")

for dist in districts:
    print(f"Đang xử lý quận: {dist['name']}...")
    
    # --- LẤY DỮ LIỆU PM2.5 ---
    aq_url = f"https://air-quality-api.open-meteo.com/v1/air-quality?latitude={dist['lat']}&longitude={dist['lon']}&hourly=pm2_5&start_date={start_date}&end_date={end_date}&timezone=Asia%2FBangkok"
    aq_response = requests.get(aq_url).json()
    
    hourly_aq = aq_response['hourly']
    df_aq = pd.DataFrame({
        'Timestamp': hourly_aq['time'],
        'PM2.5': hourly_aq['pm2_5']
    })
    
    # --- LẤY DỮ LIỆU THỜI TIẾT LỊCH SỬ ---
    weather_url = f"https://archive-api.open-meteo.com/v1/archive?latitude={dist['lat']}&longitude={dist['lon']}&start_date={start_date}&end_date={end_date}&hourly=temperature_2m,relative_humidity_2m,wind_speed_10m&timezone=Asia%2FBangkok"
    weather_response = requests.get(weather_url).json()
    
    hourly_weather = weather_response['hourly']
    df_weather = pd.DataFrame({
        'Timestamp': hourly_weather['time'],
        'Temperature': hourly_weather['temperature_2m'],
        'Humidity': hourly_weather['relative_humidity_2m'],
        'Wind_Speed': hourly_weather['wind_speed_10m']
    })
    
    # --- GỘP THỜI TIẾT VÀ PM2.5 THEO TIMESTAMP ---
    df_district = pd.merge(df_aq, df_weather, on='Timestamp')
    
    # --- THÊM CÁC BIẾN KHÔNG GIAN (SPATIAL & STATIC FEATURES) ---
    df_district['District_ID'] = dist['name']
    df_district['Latitude'] = dist['lat']
    df_district['Longitude'] = dist['lon']
    df_district['Area_Type'] = dist['area_type']
    df_district['Pop_Density'] = dist['pop_density']
    
    # Đưa vào danh sách tổng
    all_district_data.append(df_district)
    
    # Nghỉ 1 giây để tránh bị API chặn (Rate limit)
    time.sleep(1)

# 3. GỘP TẤT CẢ CÁC QUẬN THÀNH MỘT DATASET PHẲNG (FLATTENED DATASET)
final_df = pd.concat(all_district_data, ignore_index=True)

# Sắp xếp lại thứ tự các cột cho đẹp và logic
column_order = ['Timestamp', 'District_ID', 'Latitude', 'Longitude', 'Area_Type', 'Pop_Density', 'Temperature', 'Humidity', 'Wind_Speed', 'PM2.5']
final_df = final_df[column_order]

# 4. XUẤT FILE CSV
final_df.to_csv("hanoi_spatio_temporal_pm25.csv", index=False)
print("\n--- HOÀN THÀNH! Đã lưu file hanoi_spatio_temporal_pm25.csv ---")
print(f"Tổng số dòng thu thập được: {len(final_df)}")